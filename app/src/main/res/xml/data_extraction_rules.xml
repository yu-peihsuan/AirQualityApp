<?xml version="1.0" encoding="utf-8"?>
<!--
   API 31 以上的備份與裝置轉移規則。排除理由見 backup_rules.xml。
   device-transfer（換機直接傳輸）同樣要排除憑證，否則兩台裝置會共用同一個身分。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth.xml"/>
        <exclude domain="sharedpref" path="fcm.xml"/>
        <exclude domain="sharedpref" path="health_profile.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth.xml"/>
        <exclude domain="sharedpref" path="fcm.xml"/>
        <exclude domain="sharedpref" path="health_profile.xml"/>
    </device-transfer>
</data-extraction-rules>
